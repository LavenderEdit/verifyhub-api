# System Environment Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:4000

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://verifyhub_user:verifyhub_password@localhost:5435/verifyhub_db?schema=public

# Redis Configuration (Redis 8)
REDIS_URL=redis://localhost:6375/0

# Security (JWT, Cookies & Encryption)
JWT_ACCESS_SECRET=vh_access_secret_change_me_in_prod_at_least_32_chars
JWT_REFRESH_SECRET=vh_refresh_secret_change_me_in_prod_at_least_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
ENCRYPTION_MASTER_KEY=8f6a9e1b2c3d4e5f6a7b8c9d0e1f2a3b  # Must be exactly 32 bytes hex for AES-256-GCM
API_KEY_PEPPER=verifyhub_pepper_salt_secret_key_change_me
WEBHOOK_SIGNING_SECRET=vh_webhook_secret_change_me

# WhatsApp Config (whatsapp-web.js)
WWEBJS_SESSION_PATH=./wwebjs_sessions
WWEBJS_CHROMIUM_EXECUTABLE_PATH=

# Rate Limits (Global Default Settings)
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=100

# OTP Generation Defaults
OTP_DEFAULT_EXPIRATION_MINUTES=5
OTP_DEFAULT_LENGTH=6
